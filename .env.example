# Fourthwall shop (see src/shop.js). Both must be set for the live shop;
# without them /shop renders the preview/"opening soon" state.
#
# Storefront token: Fourthwall dashboard -> Settings -> For Developers.
# This is the PUBLIC read-only browsing token (ptkn_...), safe in client
# code. NEVER put the Platform API key (Basic auth) in this file or in
# any VITE_ variable - VITE_ vars are bundled into the public JS.
VITE_FOURTHWALL_TOKEN=

# The Fourthwall-hosted shop origin used for product links + checkout,
# e.g. https://notsosimplesalads-shop.fourthwall.com or a custom domain
# like https://shop.notsosimplesalads.com (no trailing slash).
VITE_FOURTHWALL_SHOP_URL=
